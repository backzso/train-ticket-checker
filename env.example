# TCDD API Yapılandırması
TCDD_ENDPOINT=https://web-api-prod-ytp.tcddtasimacilik.gov.tr/tms/train/train-availability?environment=dev&userId=1
DEPARTURE_STATION_ID=1323
DEPARTURE_STATION_NAME=İSTANBUL(BOSTANCI)
ARRIVAL_STATION_ID=98
ARRIVAL_STATION_NAME=ANKARA GAR

# Aranacak tarih (YYYY-AA-GG veya GG-AA-YYYY)
DEPARTURE_DATE=2025-12-30

# TCDD Kimlik Doğrulama
# Tarayıcıda ebilet.tcddtasimacilik.gov.tr üzerinde arama yapıp
# DevTools > Network > isteğin Authorization başlığından alınır.
# Token ömrü ~15 aydır; dolmadan 7 gün önce Telegram'dan uyarı gelir.
TCDD_AUTH_TOKEN=your_tcdd_auth_token_here
UNIT_ID=3895

# Kontrol saatleri (24 saat, Türkiye saati)
CHECK_START=06:00
CHECK_END=23:59
POLL_INTERVAL_MINUTES=15

# Sadece şu andan en az bu kadar dakika sonra kalkan seferleri bildir
# (yetişilemeyecek yakın/geçmiş seferler elenir).
MIN_LEAD_MINUTES=60

# Aynı gün boşalan koltuk için: sabit DEPARTURE_DATE yerine bugünü kontrol et.
CHECK_TODAY=true

# Çoklu tarih kontrolü (CHECK_TODAY ile birlikte kullanılmaz)
CHECK_MULTIPLE_DATES=false
MAX_DAYS_TO_CHECK=7

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Bildirimler (varsayılan açık; kapatmak için 'false')
SEND_NOTIFICATIONS=true

# --- Sadece interaktif bot (npm run start:bot) için ---
# Sunucunun genel adresi; verilirse webhook otomatik kurulur.
# PUBLIC_URL=https://your-app.onrender.com
# Webhook doğrulama anahtarı (rastgele bir dize üretin).
# WEBHOOK_SECRET=your_random_secret_here
# PORT=3000
