{
  "name": "train-ticket-checker",
  "version": "1.0.0",
  "description": "Train seat availability checker with Telegram notifications",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "start:continuous": "node dist/index.js --continuous",
    "start:bot": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "check:token": "tsc && node dist/check-token.js",
    "dev": "tsc && node dist/index.js",
    "dev:continuous": "tsc && node dist/index.js --continuous",
    "dev:bot": "tsc && node dist/server.js"
  },
  "keywords": [
    "train",
    "ticket",
    "checker",
    "telegram",
    "notifications",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
